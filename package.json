{
  "name": "postgres-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for PostgreSQL database queries via Cloud SQL Proxy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsx --test test/db-config.test.ts test/sql-guard.test.ts test/read-only.integration.test.ts test/query-limit.integration.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
